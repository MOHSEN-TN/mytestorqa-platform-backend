# SMART-QA - configuration locale/cloud
# Copier uniquement les variables utiles dans le vrai fichier .env.
# Ne jamais versionner une vraie clé Gemini.

# =========================================================
# OLLAMA LOCAL
# =========================================================
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_TIMEOUT_MS=600000
OLLAMA_NUM_CTX=4096
OLLAMA_KEEP_ALIVE=15m
OLLAMA_TEMPERATURE=0.1
OLLAMA_MAX_RETRIES=1
OLLAMA_STATUS_CACHE_MS=60000
OLLAMA_SERIALIZE_REQUESTS=true
OLLAMA_FALLBACK_TO_RULES=false

OLLAMA_TEST_NUM_CTX=4096
OLLAMA_TEST_NUM_PREDICT=1024
OLLAMA_TEST_TIMEOUT_MS=600000
OLLAMA_TEST_MAX_SUGGESTIONS=5
OLLAMA_TEST_MAX_SNAPSHOT_CHARS=10000
OLLAMA_TEST_SAFE_RETRY=true
OLLAMA_RECOVERY_WAIT_MS=20000

OLLAMA_CHAT_NUM_CTX=4096
OLLAMA_CHAT_NUM_PREDICT=256
OLLAMA_CHAT_HISTORY_LIMIT=6

# =========================================================
# GEMINI CLOUD
# =========================================================
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.6-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT_MS=120000
GEMINI_MAX_RETRIES=1
GEMINI_TEMPERATURE=1
GEMINI_MAX_OUTPUT_TOKENS=4096
GEMINI_STATUS_CACHE_MS=300000
GEMINI_FALLBACK_TO_RULES=false

GEMINI_TEST_MAX_OUTPUT_TOKENS=4096
GEMINI_TEST_TIMEOUT_MS=180000
GEMINI_TEST_MAX_SUGGESTIONS=5
GEMINI_TEST_MAX_SNAPSHOT_CHARS=24000
GEMINI_TEST_TEMPERATURE=1

GEMINI_CHAT_MAX_OUTPUT_TOKENS=2048
GEMINI_CHAT_TEMPERATURE=1

# =========================================================
# SMART-QA COMMON
# =========================================================
SMART_QA_DEFAULT_PROVIDER=CLOUD_AI
SMART_QA_CHAT_HISTORY_LIMIT=20
SMART_QA_REUSE_EXPLORATION_SNAPSHOT=true
