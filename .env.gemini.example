# SMART-QA Gemini - backend only. Never expose this key to NEXT_PUBLIC_* variables.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT_MS=120000
GEMINI_MAX_RETRIES=2
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_OUTPUT_TOKENS=8192
GEMINI_TEST_MAX_OUTPUT_TOKENS=8192
GEMINI_TEST_TIMEOUT_MS=180000
GEMINI_CHAT_MAX_OUTPUT_TOKENS=2048
GEMINI_FALLBACK_TO_RULES=false
SMART_QA_DEFAULT_PROVIDER=CLOUD_AI
SMART_QA_CHAT_HISTORY_LIMIT=20
