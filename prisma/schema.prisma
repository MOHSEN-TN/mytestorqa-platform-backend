generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/**
 * =========================================================================
 */
/**
 * ENUMS
 */
/**
 * =========================================================================
 */

enum RoleType {
  ADMIN
  QA_LEAD
  TESTER
}

enum ProjectRole {
  OWNER
  QA_LEAD
  TESTER
}

enum TestCaseStatus {
  DRAFT
  READY
  DEPRECATED
}

enum TestPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ExecutionStatus {
  TODO
  SUCCESS
  FAILED
  BLOCKED
  SKIPPED
}

enum BugStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  CLOSED
  REOPENED
}

enum BugSeverity {
  MINOR
  MAJOR
  CRITICAL
  BLOCKER
}

enum BugPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ReportType {
  EXECUTION_SUMMARY
  COVERAGE
  TRENDS
  BUG_REPORT
  PERFORMANCE
}

enum ReportFormat {
  HTML
  PDF
  EXCEL
}

enum ReportStatus {
  GENERATED
  SCHEDULED
  GENERATING
  FAILED
}

/**
 * ======================= IA / AI EXPLORATION ENUMS =======================
 */

enum AIExplorationStatus {
  DRAFT
  PROCESSING
  GENERATED
  VALIDATED
  ARCHIVED
}

enum AISuggestionPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AISuggestionStatus {
  PENDING
  APPROVED
  REJECTED
  CONVERTED
}

/**
 * =========================================================================
 */
/**
 * USER
 */
/**
 * =========================================================================
 */

model User {
  id       String   @id @default(uuid())
  email    String   @unique
  password String
  role     RoleType @default(TESTER)

  firstName String?
  lastName  String?

  otpCode   String?
  otpExpiry DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  memberships ProjectMember[]

  reportedBugs Bug[] @relation("BugReporter")
  assignedBugs Bug[] @relation("BugAssignee")

  reports Report[]

  aiExplorations AIExploration[]
}

/**
 * =========================================================================
 */
/**
 * PROJECT
 */
/**
 * =========================================================================
 */

model Project {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  members    ProjectMember[]
  testSuites TestSuite[]
  campaigns  TestCampaign[]
  bugs       Bug[]
  reports    Report[]

  aiExplorations AIExploration[]

  @@index([name])
}

/**
 * =========================================================================
 */
/**
 * PROJECT MEMBERS
 */
/**
 * =========================================================================
 */

model ProjectMember {
  id        String @id @default(uuid())
  userId    String
  projectId String

  role ProjectRole @default(TESTER)

  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([userId])
  @@index([projectId])
}

/**
 * =========================================================================
 */
/**
 * TEST SUITES
 */
/**
 * =========================================================================
 */

model TestSuite {
  id          String  @id @default(uuid())
  projectId   String
  name        String
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  testCases       TestCase[]
  iterationSuites IterationSuite[]

  @@index([projectId])
}

/**
 * =========================================================================
 */
/**
 * TEST CASES
 */
/**
 * =========================================================================
 */

model TestCase {
  id          String  @id @default(uuid())
  suiteId     String
  title       String
  description String?
  expected    String?

  status   TestCaseStatus @default(DRAFT)
  priority TestPriority   @default(MEDIUM)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  suite TestSuite @relation(fields: [suiteId], references: [id], onDelete: Cascade)

  steps          TestStep[]
  iterationItems IterationItem[]
  bugs           Bug[]

  aiSuggestionId String?
  aiSuggestion   AITestSuggestion? @relation(fields: [aiSuggestionId], references: [id], onDelete: SetNull)

  @@index([suiteId])
  @@index([aiSuggestionId])
}

/**
 * =========================================================================
 */
/**
 * TEST STEP
 */
/**
 * =========================================================================
 */

model TestStep {
  id         String @id @default(uuid())
  testCaseId String

  stepOrder Int
  action    String
  expected  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  testCase TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  iterationStepResults IterationItemStep[]

  @@unique([testCaseId, stepOrder])
  @@index([testCaseId])
}

/**
 * =========================================================================
 */
/**
 * TEST CAMPAIGN
 */
/**
 * =========================================================================
 */

model TestCampaign {
  id          String  @id @default(uuid())
  projectId   String
  name        String
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  iterations TestIteration[]

  @@index([projectId])
}

/**
 * =========================================================================
 */
/**
 * TEST ITERATION
 */
/**
 * =========================================================================
 */

model TestIteration {
  id          String  @id @default(uuid())
  campaignId  String
  name        String
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  campaign TestCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  suites IterationSuite[]
  items  IterationItem[]

  @@index([campaignId])
}

/**
 * =========================================================================
 */
/**
 * ITERATION SUITE
 */
/**
 * =========================================================================
 */

model IterationSuite {
  id          String @id @default(uuid())
  iterationId String
  suiteId     String

  createdAt DateTime @default(now())

  iteration TestIteration @relation(fields: [iterationId], references: [id], onDelete: Cascade)

  suite TestSuite @relation(fields: [suiteId], references: [id], onDelete: Cascade)

  @@unique([iterationId, suiteId])
  @@index([iterationId])
  @@index([suiteId])
}

/**
 * =========================================================================
 */
/**
 * ITERATION ITEM
 */
/**
 * =========================================================================
 */

model IterationItem {
  id          String @id @default(uuid())
  iterationId String
  testCaseId  String

  status ExecutionStatus @default(TODO)

  comment    String?
  duration   Int?
  executedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  iteration TestIteration @relation(fields: [iterationId], references: [id], onDelete: Cascade)

  testCase TestCase @relation(fields: [testCaseId], references: [id], onDelete: Restrict)

  stepResults IterationItemStep[]
  bugs        Bug[]

  @@unique([iterationId, testCaseId])
  @@index([iterationId])
  @@index([testCaseId])
  @@index([status])
}

/**
 * =========================================================================
 */
/**
 * ITERATION ITEM STEP
 */
/**
 * =========================================================================
 */

model IterationItemStep {
  id              String @id @default(uuid())
  iterationItemId String
  testStepId      String

  status ExecutionStatus @default(TODO)

  comment    String?
  executedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  iterationItem IterationItem @relation(fields: [iterationItemId], references: [id], onDelete: Cascade)

  testStep TestStep @relation(fields: [testStepId], references: [id], onDelete: Cascade)

  @@unique([iterationItemId, testStepId])
  @@index([iterationItemId])
  @@index([testStepId])
  @@index([status])
}

/**
 * =========================================================================
 */
/**
 * BUG
 */
/**
 * =========================================================================
 */

model Bug {
  id          String  @id @default(uuid())
  title       String
  description String?
  steps       String?

  status   BugStatus   @default(NEW)
  severity BugSeverity @default(MAJOR)
  priority BugPriority @default(MEDIUM)

  projectId   String?
  testCaseId  String?
  executionId String?

  reporterId String
  assigneeId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  testCase TestCase? @relation(fields: [testCaseId], references: [id], onDelete: SetNull)

  execution IterationItem? @relation(fields: [executionId], references: [id], onDelete: SetNull)

  reporter User @relation("BugReporter", fields: [reporterId], references: [id], onDelete: Cascade)

  assignee User? @relation("BugAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([testCaseId])
  @@index([executionId])
  @@index([reporterId])
  @@index([assigneeId])
  @@index([status])
  @@index([severity])
  @@index([priority])
}

/**
 * =========================================================================
 */
/**
 * REPORTS
 */
/**
 * =========================================================================
 */

model Report {
  id     String       @id @default(uuid())
  name   String
  type   ReportType
  format ReportFormat

  status ReportStatus @default(GENERATED)

  period  String?
  size    String?
  fileUrl String?

  includeCharts  Boolean @default(true)
  includeDetails Boolean @default(true)
  includeLogs    Boolean @default(false)

  projectId   String?
  createdById String

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  createdBy User @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([createdById])
  @@index([type])
  @@index([format])
  @@index([status])
  @@index([createdAt])
}

/**
 * =========================================================================
 */
/**
 * AI EXPLORATION
 */
/**
 * =========================================================================
 */

model AIExploration {
  id          String @id @default(uuid())
  projectId   String
  createdById String

  title   String
  prompt  String
  context String?

  // Fields for AI Agent exploration
  targetUrl String?
  depth     Int     @default(2)

  authenticationRequired Boolean @default(false)
  username               String?
  password               String?

  generatePlaywright    Boolean @default(true)
  generateGherkin       Boolean @default(true)
  generateNegativeTests Boolean @default(false)

  status AIExplorationStatus @default(DRAFT)

  generatedCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdBy User @relation(fields: [createdById], references: [id], onDelete: Cascade)

  suggestions AITestSuggestion[]

  @@index([projectId])
  @@index([createdById])
  @@index([status])
  @@index([targetUrl])
  @@index([createdAt])
}

/**
 * =========================================================================
 */
/**
 * AI TEST SUGGESTIONS
 */
/**
 * =========================================================================
 */

model AITestSuggestion {
  id            String @id @default(uuid())
  explorationId String

  title          String
  description    String?
  expectedResult String?

  priority AISuggestionPriority @default(MEDIUM)

  status AISuggestionStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  exploration AIExploration @relation(fields: [explorationId], references: [id], onDelete: Cascade)

  convertedTestCases TestCase[]

  @@index([explorationId])
  @@index([priority])
  @@index([status])
}
