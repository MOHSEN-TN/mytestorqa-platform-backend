generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleType {
  ADMIN
  QA_LEAD
  TESTER
}

enum ProjectRole {
  OWNER
  QA_LEAD
  TESTER
}

enum TestCaseStatus {
  DRAFT
  READY
  DEPRECATED
}

enum TestPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ExecutionStatus {
  TODO
  SUCCESS
  FAILED
  BLOCKED
  SKIPPED
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      RoleType @default(TESTER)
  firstName String?
  lastName  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  otpCode   String?
  otpExpiry DateTime?
  memberships ProjectMember[]
}

model Project {
  id        String   @id @default(uuid())
  name      String @unique
  createdAt DateTime @default(now())

  members    ProjectMember[]
  testSuites TestSuite[]
  campaigns  TestCampaign[]
}

model ProjectMember {
  id        String      @id @default(uuid())
  userId    String
  projectId String
  role      ProjectRole @default(TESTER)
  createdAt DateTime    @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([userId])
  @@index([projectId])
}

model TestSuite {
  id          String   @id @default(uuid())
  projectId   String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  testCases       TestCase[]
  iterationSuites IterationSuite[]

  @@index([projectId])
}

model TestCase {
  id          String         @id @default(uuid())
  suiteId     String
  title       String
  description String?
  expected    String?
  status      TestCaseStatus @default(DRAFT)
  priority    TestPriority   @default(MEDIUM)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  suite          TestSuite       @relation(fields: [suiteId], references: [id], onDelete: Cascade)
  steps          TestStep[]
  iterationItems IterationItem[]

  @@index([suiteId])
}

model TestStep {
  id         String   @id @default(uuid())
  testCaseId String
  stepOrder  Int
  action     String
  expected   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  testCase TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  @@unique([testCaseId, stepOrder])
  @@index([testCaseId])
}

model TestCampaign {
  id          String   @id @default(uuid())
  projectId   String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project    Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  iterations TestIteration[]

  @@index([projectId])
}

model TestIteration {
  id          String   @id @default(uuid())
  campaignId  String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  campaign TestCampaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  suites   IterationSuite[]
  items    IterationItem[]

  @@index([campaignId])
}

model IterationSuite {
  id          String   @id @default(uuid())
  iterationId String
  suiteId     String
  createdAt   DateTime @default(now())

  iteration TestIteration @relation(fields: [iterationId], references: [id], onDelete: Cascade)
  suite     TestSuite     @relation(fields: [suiteId], references: [id], onDelete: Cascade)

  @@unique([iterationId, suiteId])
  @@index([iterationId])
  @@index([suiteId])
}

model IterationItem {
  id          String          @id @default(uuid())
  iterationId String
  testCaseId  String
  status      ExecutionStatus @default(TODO)
  comment     String?
  duration    Int?
  executedAt  DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  iteration TestIteration @relation(fields: [iterationId], references: [id], onDelete: Cascade)
  testCase  TestCase      @relation(fields: [testCaseId], references: [id], onDelete: Restrict)

  @@unique([iterationId, testCaseId])
  @@index([iterationId])
  @@index([testCaseId])
}
