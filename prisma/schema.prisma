generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleType {
  ADMIN
  QA_LEAD
  TESTER
}

enum ProjectRole {
  OWNER
  QA_LEAD
  TESTER
}

model ProjectMember {
  id        String      @id @default(uuid())
  userId    String
  projectId String
  role      ProjectRole @default(TESTER)
  createdAt DateTime    @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([userId])
  @@index([projectId])
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      RoleType @default(TESTER)
  createdAt DateTime @default(now())

  memberships ProjectMember[]
}

model Project {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  members    ProjectMember[]
  testCases  TestCase[]
  testSuites TestSuite[]
}

// =========================
// Test Cases
// =========================

enum TestCaseStatus {
  DRAFT
  READY
  DEPRECATED
}

enum TestPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model TestCase {
  id          String         @id @default(uuid())
  projectId   String
  title       String
  description String?
  expected    String?
  status      TestCaseStatus @default(DRAFT)
  priority    TestPriority   @default(MEDIUM)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  steps      TestStep[]
  suiteItems SuiteItem[]
  runItems   RunItem[]

  @@index([projectId])
}

model TestStep {
  id         String   @id @default(uuid())
  testCaseId String
  stepOrder  Int
  action     String
  expected   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  testCase TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  @@index([testCaseId])
  @@unique([testCaseId, stepOrder])
}

// =========================
// Test Suites
// =========================

model TestSuite {
  id        String   @id @default(uuid())
  projectId String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items   SuiteItem[]
  runs    TestRun[]

  @@index([projectId])
}

model SuiteItem {
  id         String   @id @default(uuid())
  suiteId    String
  testCaseId String
  order      Int
  createdAt  DateTime @default(now())

  suite    TestSuite @relation(fields: [suiteId], references: [id], onDelete: Cascade)
  testCase TestCase  @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  @@unique([suiteId, testCaseId])
  @@unique([suiteId, order])
  @@index([suiteId])
  @@index([testCaseId])
}

// =========================
// Test Runs
// =========================

enum RunStatus {
  TODO
  PASSED
  FAILED
  BLOCKED
  SKIPPED
}

model TestRun {
  id        String   @id @default(uuid())
  suiteId   String
  name      String
  createdAt DateTime @default(now())

  suite TestSuite @relation(fields: [suiteId], references: [id], onDelete: Cascade)
  items RunItem[]

  @@index([suiteId])
}

model RunItem {
  id         String    @id @default(uuid())
  runId      String
  testCaseId String
  status     RunStatus @default(TODO)
  comment    String?
  duration   Int?

  run      TestRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  testCase TestCase @relation(fields: [testCaseId], references: [id], onDelete: Restrict)

  @@unique([runId, testCaseId])
  @@index([runId])
  @@index([testCaseId])
}